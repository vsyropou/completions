{
  "name": "completion",
  "displayName": "Completion",
  "description": "Low-latency multiline code completion",
  "version": "0.0.1",
  "publisher": "vasilis",
  "engines": { "vscode": "^1.85.0" },
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Completion",
      "properties": {
        "completion.sidecarPath": {
          "type": "string",
          "default": "",
          "description": "Override sidecar binary path (dev use)"
        },
        "completion.phoenixUrl": {
          "type": "string",
          "default": "http://localhost:4000",
          "description": "Phoenix backend URL"
        },
        "completion.authToken": {
          "type": "string",
          "default": "dev-token",
          "description": "Phoenix bearer token"
        },
        "completion.maxTokens": {
          "type": "number",
          "default": 128,
          "description": "Max tokens per completion"
        },
        "completion.measureLatency": {
          "type": "boolean",
          "default": false,
          "description": "Log per-request latency breakdown to the output channel"
        },
        "completion.modelUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of the model server, e.g. http://localhost:8000. Empty = mock completions."
        },
        "completion.modelApiKey": {
          "type": "string",
          "default": "",
          "description": "Bearer token for the model server. Empty = no auth header."
        },
        "completion.model": {
          "type": "string",
          "default": "",
          "description": "Model id, e.g. qwen2.5-coder-7b. Empty = 'default'."
        },
        "completion.fimTemplate": {
          "type": "string",
          "default": "<|fim_prefix|>{prefix}<|fim_suffix|>{suffix}<|fim_middle|>",
          "description": "FIM template with {prefix} and {suffix} placeholders."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
